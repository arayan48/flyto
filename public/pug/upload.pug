doctype html
- const bundle = frontend('upload')
- const band = true
html(lang=lang.langCode)
  head
    include partials/head
    include partials/head_custom
  body(class=band ? 'has-band' : null)
    include partials/header
    main.page.site-main
      #upload
    include partials/footer
    script FLYTO_UPLOAD_PATH = '#{uploadAppPath}';
    if bundle.js
      script(type='module' src='app/' + bundle.js)
