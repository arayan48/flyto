doctype html
html(lang=lang.langCode)
  head
    include partials/head
    style.
      html {
        position: relative;
        min-height: 100%;
      }
      body > .container {
        padding-bottom: 50px;
        position: relative;
      }
      .footer {
        position: absolute;
        bottom: 0;
        width: 100%;
        height: 40px;
        line-height: 40px;
      }
    include partials/head_custom
  body
    .container
      include partials/header
      p.alert.alert-danger
        strong #{error}
      p
        a.btn.btn-sm.btn-info(title=lang.newUpload href=uploadAppPath) #{lang.newUpload}
    include partials/footer
