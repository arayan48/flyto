base(href=baseUrl)
meta(charset='utf-8')
title= site && site.siteName || 'Flyto'
link(href='assets/brand/favicon.svg' rel='icon' type='image/svg+xml')
link(href='assets/brand/favicon-32.png' rel='icon' type='image/png' sizes='32x32')
link(href='assets/favicon.ico' rel='alternate icon' type='image/x-icon')
link(href='assets/brand/apple-touch-icon.png' rel='apple-touch-icon' sizes='180x180')
link(href='site.webmanifest' rel='manifest')
meta(name='theme-color' content='#2F6BFF')
meta(name='viewport' content='width=device-width, initial-scale=1')
meta(name='robots' content='noindex,nofollow')
meta(http-equiv='x-ua-compatible' content='IE=edge')
meta(property='og:title' content=site && site.siteName || 'Flyto')
if site && site.siteDescription
  meta(name='description' content=site.siteDescription)
  meta(property='og:description' content=site.siteDescription)
if origin
  meta(property='og:image' content=origin + 'assets/brand/og-image.png')
meta(property='og:image:width' content='1200')
meta(property='og:image:height' content='630')
link(href='assets/styles.css' rel='stylesheet')
link(href='assets/fonts/dm-sans/wght.css' rel='stylesheet')
link(href='assets/brand.css' rel='stylesheet')
if bundle
  each file in bundle.css
    link(href='app/' + file rel='stylesheet')
  each file in bundle.preload
    link(href='app/' + file rel='modulepreload')
