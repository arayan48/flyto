header.site-header
  .page.site-header-inner
    a.site-home(href=uploadAppPath title=site.siteName)
      include logo
    nav.site-nav(aria-label=lang.nav.account)
      if user
        a.site-nav-link(href='account' title=lang.nav.account)
          span.site-nav-full #{user.name || user.email}
          span.site-nav-short #{lang.nav.account}
        if user.role === 'admin'
          a.site-nav-link(href='admin') #{lang.nav.admin}
        form.site-logout(method='post' action='api/auth/logout')
          input(type='hidden' name='_csrf' value=csrf)
          button.btn.btn-ghost.btn-sm(type='submit') #{lang.nav.logout}
      else
        a.site-nav-link(href='login') #{lang.nav.login}
        if site.registrationMode === 'open'
          a.btn.btn-sm(href='register') #{lang.nav.register}
if site.maintenanceMode || site.announcementText
  .page.site-banners
    if site.maintenanceMode
      .alert.alert-warning
        div
          strong #{lang.maintenanceTitle}
          |  #{site.maintenanceMessage || lang.maintenanceDefault}
    if site.announcementText
      .alert(class=site.announcementLevel === 'success' ? 'alert-success' : site.announcementLevel === 'warning' ? 'alert-warning' : site.announcementLevel === 'danger' ? 'alert-danger' : 'alert-info') #{site.announcementText}
