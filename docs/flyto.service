[Unit]
Description=Flyto
Documentation=https://github.com/arayan48/flyto
After=network.target

[Service]
Type=simple
User=flyto
Restart=on-failure

Environment=NODE_ENV=production
Environment=FLYTO_PORT=8080

WorkingDirectory=/opt/flyto
ExecStart=/usr/bin/node app.js

[Install]
WantedBy=multi-user.target
